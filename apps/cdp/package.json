{
  "name": "@docs-compare/cdp",
  "version": "0.1.0",
  "private": true,
  "description": "Docs Compare 的 CDP 实现:Node CLI 驱动 Chrome,双窗口对照阅读,同步引擎复用 core。",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "selftest": "npm run build && node dist/main.js --selftest",
    "selftest:live": "npm run build && node dist/main.js --selftest=live"
  },
  "dependencies": {
    "@docs-compare/core": "0.1.0",
    "puppeteer-core": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
