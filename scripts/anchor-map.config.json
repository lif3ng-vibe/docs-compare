      "dir": "mattpocock-skills-docs-cn",
      "origin": "https://www.aihero.dev/skills",
      "mirror": "https://lif3ng-vibe.github.io/docs-cn/mattpocock-skills",
      "useSourceFrontmatter": true,
      "manualOverrides": {
        "/": {
          "安装30-秒": "skills-install-heading",
          "这些技能为什么存在": null,
          "参考技能怎么分类": "skill-set-heading"
