{
  "name": "docs-compare",
  "private": true,
  "version": "0.1.0",
  "description": "双语文档对照阅读:原站 ↔ GitHub Pages 汉化镜像,同步跳转/锚点/滚动。多实现共用核心逻辑。",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @docs-compare/chrome-extension",
    "watch": "npm run watch --workspace @docs-compare/chrome-extension",
    "build:tauri": "npm run build --workspace @docs-compare/tauri",
    "build:apple": "npm run build --workspace @docs-compare/apple",
    "sim:apple": "npm run sim --workspace @docs-compare/apple",
    "cdp": "npm run build --workspace @docs-compare/cdp --silent && node apps/cdp/dist/main.js",
    "selftest": "npm run selftest --workspace @docs-compare/tauri",
    "selftest:live": "npm run selftest:live --workspace @docs-compare/tauri",
    "selftest:layout": "npm run selftest:layout --workspace @docs-compare/tauri",
    "selftest:multiwindow": "npm run selftest:multiwindow --workspace @docs-compare/tauri",
    "selftest:apple": "npm run selftest --workspace @docs-compare/apple",
    "selftest:apple:live": "npm run selftest:live --workspace @docs-compare/apple",
    "selftest:apple:layout": "npm run selftest:layout --workspace @docs-compare/apple",
    "selftest:cdp": "npm run selftest --workspace @docs-compare/cdp",
    "selftest:cdp:live": "npm run selftest:live --workspace @docs-compare/cdp",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
